# AI Response Validation & Quality Intelligence Platform Configuration

# Server Port & Host
PORT=3000
NODE_ENV=development

# LLM Providers (Optional - Platform includes built-in semantic & deterministic evaluation engine + Demo Mode)
# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
DATABASE_URL=./data/quality_intelligence.db

# Evaluation Default Weights (Percentages totaling 100)
WEIGHT_RELEVANCE=20
WEIGHT_ACCURACY=35
WEIGHT_HALLUCINATION=25
WEIGHT_COMPLETENESS=20

# Verdict Thresholds (Scores out of 100)
THRESHOLD_PASS=80
THRESHOLD_NEEDS_IMPROVEMENT=60

# Demo Mode Enabled by default for flawless demonstration without requiring live API credits
ENABLE_DEMO_MODE=true
